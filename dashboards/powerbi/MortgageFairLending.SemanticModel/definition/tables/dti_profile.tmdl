table dti_profile

	measure 'Denial rate by DTI' = DIVIDE(SUMX(dti_profile, dti_profile[applications] * dti_profile[denial_rate]), SUM(dti_profile[applications]))
		formatString: 0.0%

	column loan_type
		dataType: string
		summarizeBy: none
		sourceColumn: loan_type

	column dti_value
		dataType: int64
		summarizeBy: sum
		sourceColumn: dti_value

	column dti_band
		dataType: string
		summarizeBy: none
		sourceColumn: dti_band

	column applications
		dataType: int64
		summarizeBy: sum
		sourceColumn: applications

	column denial_rate
		dataType: double
		formatString: 0.0%
		summarizeBy: sum
		sourceColumn: denial_rate

	column share_of_denials_citing_dti
		dataType: double
		formatString: 0.0%
		summarizeBy: sum
		sourceColumn: share_of_denials_citing_dti

	partition dti_profile = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dti_profile.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"loan_type", type text}, {"dti_value", Int64.Type}, {"dti_band", type text}, {"applications", Int64.Type}, {"denial_rate", type number}, {"share_of_denials_citing_dti", type number}}, "en-US")
				in
				    Typed

